# Copy this file to .env and fill in real values before running
# `docker compose up -d`. These are the GUI login credentials — not
# related to the Cloudflare API token, which you enter through the GUI itself.

AUTH_USER=admin
AUTH_PASSWORD=change-me

# How often (in minutes) the updater checks the public IP and reconciles
# DNS records. Optional — defaults to 5 if omitted.
UPDATE_INTERVAL_MINUTES=5
